//------------------------------------------------
// 010 Editor Template: P.N.03 (GameCube) .dat archive (em/, etc/, id/)
// Big endian.
//------------------------------------------------
BigEndian();

uint32 count;
uint32 offset[count] <format=hex>;
char   type[count * 4];

local int i;
local uint32 endOff;
for (i = 0; i < count; i++) {
    endOff = (i + 1 < count) ? offset[i + 1] : FileSize();
    FSeek(offset[i]);
    struct { ubyte data[endOff - offset[i]]; } entry <read=Str("%c%c%c", type[i*4], type[i*4+1], type[i*4+2])>;
}
